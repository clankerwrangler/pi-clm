{
  "name": "@clankerwrangler/pi-clm",
  "version": "1.0.0",
  "description": "Pi extension that lets the model manage its own context: the next request's context is mirrored to a file the model edits with ordinary tools",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/clankerwrangler/pi-clm#readme",
  "bugs": {
    "url": "https://github.com/clankerwrangler/pi-clm/issues"
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "context-management",
    "context-window",
    "context-language-models"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/clankerwrangler/pi-clm/main/.github/images/overview.png"
  },
  "files": [
    "index.ts",
    "src/**",
    "!src/__tests__/**",
    "steering/**",
    "docs/*.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && tsx --test src/__tests__/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typebox": "1.1.12",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clankerwrangler/pi-clm.git"
  },
  "private": true
}
